# Copia este archivo a ".env.local" y completa los valores reales.
# ".env.local" nunca se sube a git y Next.js lo carga automaticamente.

# IA (Anthropic) - recomendaciones del cuestionario
# Crea la clave en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Stripe - cobros en USD
# Claves en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mercado Pago - cobros en PEN (Peru)
# Credenciales en https://www.mercadopago.com.pe/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Resend - envio del resumen de pedido por correo
# Clave en https://resend.com/api-keys
RESEND_API_KEY=
# Correo remitente verificado en Resend (dominio propio verificado)
ORDER_EMAIL_FROM=pedidos@tu-dominio.com
# Correo del vendedor que recibe cada pedido
ORDER_EMAIL_TO=lazocorinafanny123@gmail.com

# URL publica del sitio (usada para los redirect de Stripe/Mercado Pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
